{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  // src/lib/claudePrompt.ts joins scoring.ts here for the same reason:
  // it is a pure function with a leakage rule that has to be enforced by
  // test (no notes, no contact details), and the test suite runs under
  // this project.
  "include": ["server", "shared", "scripts", "src/data", "src/types.ts", "src/lib/scoring.ts", "src/lib/claudePrompt.ts"]
}

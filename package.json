{
  "name": "vamos-deal-radar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"npm run dev:server\"",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "build:demo": "tsc -b && VITE_DEMO_MODE=true vite build --outDir dist-demo",
    "preview:demo": "vite preview --outDir dist-demo --port 4173",
    "demo:scan": "tsx scripts/demo-bundle-scan.ts",
    "dev:web": "vite",
    "dev:server": "PORT=8787 tsx watch --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "start": "NODE_ENV=production tsx --env-file-if-exists=.env server/index.ts",
    "db:backup": "tsx --env-file-if-exists=.env scripts/db-backup.ts",
    "db:list-backups": "tsx --env-file-if-exists=.env scripts/db-list-backups.ts",
    "db:restore": "tsx --env-file-if-exists=.env scripts/db-restore.ts",
    "db:integrity": "tsx --env-file-if-exists=.env scripts/db-integrity.ts",
    "db:qualify-pending": "tsx --env-file-if-exists=.env scripts/qualify-pending.ts",
    "db:backfill-dates": "tsx --env-file-if-exists=.env scripts/backfill-evidence-dates.ts",
    "db:enrich": "tsx --env-file-if-exists=.env scripts/enrich-companies.ts",
    "smoke-test": "tsx --env-file-if-exists=.env scripts/smoke-test.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "discovery:preview": "tsx --env-file-if-exists=.env scripts/discovery-preview.ts",
    "db:rescore": "tsx --env-file-if-exists=.env scripts/rescore.ts",
    "diligence": "tsx --env-file-if-exists=.env scripts/candidate-diligence.ts",
    "pilot:finalize": "tsx --env-file-if-exists=.env scripts/finalize-pilot-candidates.ts",
    "db:correct-stage": "tsx --env-file-if-exists=.env scripts/correct-inferred-stage.ts",
    "db:backfill-founded-year": "tsx --env-file-if-exists=.env scripts/backfill-founded-year.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "tailwindcss": "^4.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}

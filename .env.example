# ── Vamos Deal Radar — environment ───────────────────────────────
# There is no demo/mock mode. An integration is LIVE when its
# credentials are configured below; otherwise it is simply not
# connected, and every action against it fails with an honest error.
# The app boots fine with zero credentials — it just starts empty.

# Frontend origin allowed by CORS (also the OAuth redirect target).
FRONTEND_URL=http://localhost:5173

# ── HubSpot (live requires: HUBSPOT_ACCESS_TOKEN) ────────────────
# Private-app token with crm.objects.companies/contacts/deals/notes
# read+write scopes. HUBSPOT_PORTAL_ID enables deep links to records.
# HubSpot — EITHER a private-app token…
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
# …OR an OAuth app (user clicks Connect in Data Sources):
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8787/api/hubspot/callback

# ── Microsoft Entra: sign-in (SSO) and Outlook mailbox ────────────
# ONE Entra app registration serves both. The two consents are
# deliberately SEPARATE — signing in to read company records must not
# require handing over mailbox access — so there are TWO redirect URIs
# and two scope sets. Register both URIs in Entra.
#
#   Sign-in  ->  MICROSOFT_SSO_REDIRECT_URI
#                scopes: openid, profile, email, User.Read
#   Mailbox  ->  MICROSOFT_REDIRECT_URI
#                scopes: Mail.ReadWrite, offline_access, User.Read
#
# NEVER grant, and this app never requests: Mail.Send, Mail.*.Shared,
# or any application-level Mail permission. There is no send path and
# no delete path anywhere in this codebase; a person sends from their
# own Outlook after reading the draft.
#
# Values below are NAMES ONLY — never commit real ids or secrets.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# MUST be the Vamos Ventures directory (tenant) GUID for SSO.
# 'common', 'organizations', and 'consumers' are REFUSED for sign-in:
# they would let any Microsoft account anywhere complete the flow,
# leaving a domain string as the only thing keeping strangers out. The
# tenant GUID is the primary restriction; the email domain below is a
# secondary confirmation on top of it.
MICROSOFT_TENANT_ID=common
# Mailbox consent callback (unchanged).
MICROSOFT_REDIRECT_URI=http://localhost:8787/api/outlook/callback
# Sign-in callback — a DIFFERENT path from the mailbox one above.
MICROSOFT_SSO_REDIRECT_URI=http://localhost:8787/api/auth/microsoft/callback
# Secondary check: which account domain may sign in. Defaults to
# vamosventures.com when unset.
MICROSOFT_ALLOWED_EMAIL_DOMAIN=vamosventures.com

# Which identity providers may open a session:
#   local     — administrator password only (DEFAULT)
#   microsoft — Microsoft Entra SSO only
#   hybrid    — both, for migration and live testing
# Requesting microsoft/hybrid before the MICROSOFT_* variables above are
# complete falls back to `local` and the UI reports "Awaiting Microsoft
# administrator configuration" — a missing credential can never lock the
# team out. Keep this at `local` (or `hybrid`) until Microsoft SSO has
# been successfully live-tested.
AUTH_MODE=local

# ── AI email generation (live requires: AI_PROVIDER + an API key) ─
# AI_PROVIDER: anthropic | openai. Without a provider, outreach drafts
# use a deterministic local template built only from verified facts
# (clearly labeled — no AI model is called).
# AI_API_KEY wins if set; otherwise the provider-specific key is used.
AI_PROVIDER=
AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=

# ── Live sourcing (all optional; public sources only) ────────────
# GitHub official API works unauthenticated at low rate limits; a
# token (public-data scope is enough) raises them.
GITHUB_TOKEN=
# SEC EDGAR asks automated clients to identify themselves with
# contact info in the User-Agent. Set a real address.
SEC_CONTACT_EMAIL=
# Comma-separated public RSS feed URLs for the funding-news source.
# Defaults to TechCrunch venture + startups feeds when empty. Only
# feeds that permit automated readers belong here.
FUNDING_NEWS_FEEDS=
# Comma-separated investor-newsroom feed URLs for the investor-news
# source. Defaults to the 17 firms in
# server/sourcing/investorRegistry.ts when empty. Entries on a domain
# that is not in that registry are dropped: an unregistered domain
# cannot be attributed to a firm, so nothing under it could count as
# investor-primary evidence.
INVESTOR_NEWS_FEEDS=
# Product Hunt developer token (create one at
# producthunt.com/v2/oauth/applications). Required for the Product
# Hunt source — it refuses to run without it, nothing is guessed.
PRODUCTHUNT_TOKEN=

# ── Runtime ──────────────────────────────────────────────────────
# Required for live Outlook AND for Microsoft SSO (min 16 chars).
# Encrypts OAuth tokens at rest and signs session cookies. Without it
# the cookie-signing key is random per process, so every restart signs
# everyone out — survivable locally, not acceptable once SSO is live.
SESSION_SECRET=
# Optional: SQLite database location (':memory:' in tests). Defaults
# to server/.data/deal-radar.db — a real, durable database file.
DATABASE_FILE=
PORT=8787

# Scheduled sourcing. Leave false unless the backend is continuously
# hosted; while false, schedules are stored configuration only and the
# UI shows "Configured but inactive".
RUN_SCHEDULER=false

# ── Administrator authentication ──────────────────────────────────
# The shared administrator password. Required for AUTH_MODE=local and
# AUTH_MODE=hybrid; with neither this nor Microsoft SSO configured, the
# whole application is unusable (fails closed), not open.
#
# This is one shared credential, not a user account: notes written under
# it are attributed to "Local administrator" rather than to a person.
# Microsoft SSO is what turns attribution into a real employee identity.
ADMIN_PASSWORD=

# ── AI budget, kill switch, and guardrails ────────────────────────
# There are deliberately NO environment variables for the AI budget or
# the kill switch. They are stored in the database and edited from
# Settings → AI budget & guardrails, so an administrator can stop AI
# spend immediately without a redeploy or a process restart.
#
# Defaults (see shared/ai.ts): $50/month hard cap, warnings at $25 and
# $40, $10 per sourcing run, max 10 AI-researched candidates per sector,
# and per-candidate caps of 3 web searches / 30,000 input tokens /
# 2,000 output tokens / 1 retry, max 2 concurrent.
#
# AI stays FAIL-CLOSED: with no AI_PROVIDER + key above, no model call
# is ever made and every AI feature falls back to a labeled
# deterministic local template. See AI_COSTS_AND_GUARDRAILS.md.

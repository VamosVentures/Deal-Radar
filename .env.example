# ── Vamos Deal Radar — environment ───────────────────────────────
# MOCK MODE (default): leave everything blank and set
# INTEGRATION_MODE=mock. Every integration runs as a clearly-labeled
# local simulation; nothing external is contacted.
#
# LIVE MODE: set INTEGRATION_MODE=auto and fill in the credentials
# for each integration you want live. Integrations go live
# independently — HubSpot can be live while Outlook stays in demo.

# Backend base URL (used for OAuth redirects) and the frontend origin
# allowed by CORS.
APP_BASE_URL=http://localhost:8787
FRONTEND_URL=http://localhost:5173

# ── HubSpot (live requires: HUBSPOT_ACCESS_TOKEN) ────────────────
# Private-app token with crm.objects.companies/contacts/deals/notes
# read+write scopes. HUBSPOT_PORTAL_ID enables deep links to records.
# HubSpot — EITHER a private-app token…
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=
# …OR an OAuth app (user clicks Connect in Data Sources):
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=http://localhost:8787/api/hubspot/callback

# ── Microsoft Outlook (live requires: all four + SESSION_SECRET) ──
# Entra app registration with delegated Mail.ReadWrite, User.Read,
# offline_access. Redirect URI must exactly match
# {APP_BASE_URL}/api/outlook/callback registered in Entra.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:8787/api/outlook/callback

# ── AI email generation (live requires: AI_PROVIDER + AI_API_KEY) ─
# AI_PROVIDER: anthropic | openai. Demo Mode uses a deterministic
# template generator that only assembles verified facts.
# AI: AI_API_KEY wins if set; otherwise the provider-specific key is used.
AI_PROVIDER=
AI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=

# ── Runtime ──────────────────────────────────────────────────────
# INTEGRATION_MODE: mock (force Demo Mode) | auto (live per
# integration when its credentials exist).
INTEGRATION_MODE=mock
# Required for live Outlook: encrypts OAuth tokens at rest (min 16 chars).
SESSION_SECRET=
# Optional: path for the dev datastore JSON (':memory:' in tests).
DATA_FILE=
PORT=8787

# Scheduled sourcing. Leave false unless the backend is continuously
# hosted; while false, schedules are stored configuration only and the
# UI shows "Configured but inactive".
RUN_SCHEDULER=false
